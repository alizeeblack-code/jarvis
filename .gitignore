env/

# Runtime data: everything under data/ (tasks, session index, prefs, agy logs…) and logs/
data/*
!data/.gitkeep
logs/

# Uploads (user-attached images)
data/uploads/

# Task logs (JSONL files, runtime data)
data/task_logs/

# Logs & worktrees (runtime directories)
logs/*.log
worktrees/*/

# OS
.DS_Store
Thumbs.db

